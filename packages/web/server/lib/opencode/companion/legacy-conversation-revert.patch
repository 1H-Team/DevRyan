+
+const controls = new WeakSet<object>()
+const resolvedPlugins = new Map<string, Map<string, unknown>>()
+const toolFiles = new Map<string, string[]>()
+export function files(directory: string, entries: string[]) {
+  toolFiles.set(directory, entries)
+}
+const Record = Schema.Record(Schema.String, Schema.Unknown)
+const Launch = Schema.Struct({
+  lease: Schema.Struct({ token: Schema.String, viewDirectory: Schema.String, projectDirectory: Schema.String }),
+  launch: Schema.optional(
+    Schema.Struct({
+      launcher: Schema.String,
+      arguments: Schema.Array(Schema.String),
+      cwd: Schema.String,
+      scratchDirectory: Schema.String,
+      environment: Schema.Record(Schema.String, Schema.String),
+    }),
+  ),
+})
+export const Result = Schema.Struct({
+  title: Schema.String,
+  output: Schema.String,
+  metadata: Record,
+  attachments: Schema.optional(
+    Schema.Array(
+      Schema.Struct({
+        type: Schema.Literal("file"),
+        mime: Schema.String,
+        url: Schema.String,
+        filename: Schema.optional(Schema.String),
+      }),
+    ),
+  ),
+})
+export const Frame = Schema.Union([
+  Schema.Struct({ type: Schema.Literal("result"), result: Result }),
+  Schema.Struct({ type: Schema.Literal("error"), message: Schema.String }),
+  Schema.Struct({
+    type: Schema.Literal("metadata"),
+    value: Schema.Struct({ title: Schema.optional(Schema.String), metadata: Schema.optional(Record) }),
+  }),
+  Schema.Struct({
+    type: Schema.Literal("permission"),
+    id: Schema.String,
+    value: Schema.Struct({
+      permission: Schema.String,
+      patterns: Schema.Array(Schema.String),
+      always: Schema.Array(Schema.String),
+      metadata: Record,
+    }),
+  }),
+])
+export const prefix = "DEVRYAN_TOOL:"
+export const enabled = () =>
+  process.env.DEVRYAN_EXECUTION_BOUNDARY === "1" && process.env.DEVRYAN_EXECUTION_WORKER !== "1"
+const admissions = new Map<string, Set<Fiber.Fiber<unknown, unknown>>>()
+
+// Track the whole prompt, including its prelude. SessionRunner alone owns only
+// the model loop, which starts after cleanup and message persistence.
+export function admitted<A, E, R>(sessionID: string, action: Effect.Effect<A, E, R>) {
+  if (!enabled()) return action
+  return Effect.gen(function* () {
+    const instance = yield* InstanceState.context
+    const key = JSON.stringify([instance.directory, sessionID])
+    const fiber = Fiber.getCurrent()!
+    const running = admissions.get(key) ?? new Set()
+    const nested = running.has(fiber)
+    running.add(fiber)
+    admissions.set(key, running)
+    return yield* Effect.gen(function* () {
+      yield* Effect.promise(() => rpc({ action: "admit", directory: instance.directory, sessionID }))
+      return yield* action
+    }).pipe(
+      Effect.ensuring(
+        Effect.sync(() => {
+          if (nested) return
+          running.delete(fiber)
+          if (!running.size) admissions.delete(key)
+        }),
+      ),
+    )
+  })
+}
+
+export const cancelAdmissions = (sessionID: string) =>
+  Effect.gen(function* () {
+    if (!enabled()) return
+    const instance = yield* InstanceState.context
+    const running = admissions.get(JSON.stringify([instance.directory, sessionID]))
+    const current = Fiber.getCurrent()
+    yield* Effect.forEach(
+      [...(running ?? [])].filter((fiber) => fiber !== current),
+      Fiber.interrupt,
+      { concurrency: "unbounded" },
+    )
+  })
+
+export async function rpc(params: object) {
+  const url = new URL(process.env.DEVRYAN_ORCHESTRATION_URL ?? "")
+  if (
+    url.protocol !== "http:" ||
+    url.hostname !== "127.0.0.1" ||
+    url.pathname !== "/rpc" ||
+    !process.env.DEVRYAN_ORCHESTRATION_TOKEN
+  )
+    throw new Error("mutation_runtime_unsupported")
+  const response = await fetch(url, {
+    method: "POST",
+    headers: {
+      "content-type": "application/json",
+      authorization: `Bearer ${process.env.DEVRYAN_ORCHESTRATION_TOKEN}`,
+    },
+    body: JSON.stringify({ method: "session_execution", params }),
+    signal: AbortSignal.timeout(60_000),
+  })
+  const body = Schema.decodeUnknownSync(
+    Schema.Struct({
+      ok: Schema.Boolean,
+      result: Schema.optional(Schema.Unknown),
+      error: Schema.optional(Schema.Struct({ code: Schema.optional(Schema.String) })),
+    }),
+  )(await response.json())
+  if (!response.ok || !body.ok) throw new Error(body.error?.code ?? "mutation_runtime_unavailable")
+  return body.result
+}
+
+// Only the host's content-pinned, declarative orchestration adapters can stay in
+// the control process. A custom tool with the same name remains confined.
+export async function plugin(entry: string, hooks: Hooks, options: unknown, directory: string) {
+  const plugins = resolvedPlugins.get(directory) ?? new Map<string, unknown>()
+  plugins.set(entry, options)
+  resolvedPlugins.set(directory, plugins)
+  if (!enabled()) return
+  const pins = Schema.decodeUnknownSync(Schema.Record(Schema.String, Schema.String))(
+    JSON.parse(process.env.DEVRYAN_EXECUTION_CONTROL_PLUGINS ?? "{}"),
+  )
+  const file = entry.startsWith("file:") ? fileURLToPath(entry) : entry
+  // Runtime overlays copy the reviewed entry verbatim. Accept those copies by
+  // content, never by a tool's user-controlled name or installation location.
+  if (
+    !Object.values(pins).includes(
+      createHash("sha256")
+        .update(await readFile(file))
+        .digest("hex"),
+    )
+  )
+    return
+  for (const def of Object.values(hooks.tool ?? {})) controls.add(def)
+}
+
+export const prompt = (sessionID: string, userMessageID: string) =>
+  Effect.gen(function* () {
+    if (!enabled()) return
+    const ctx = yield* InstanceState.context
+    yield* Effect.promise(() => rpc({ action: "prompt", directory: ctx.directory, sessionID, userMessageID }))
+  })
+
+export const child = (sessionID: string, parentID: string, parentCallID: string | undefined) =>
+  Effect.gen(function* () {
+    if (!enabled()) return
+    const ctx = yield* InstanceState.context
+    yield* Effect.promise(() => rpc({ action: "child", directory: ctx.directory, sessionID, parentID, parentCallID }))
+  })
+
+export function wrap<P extends Schema.Decoder<unknown>, M extends { [key: string]: unknown }>(
+  def: Tool.Def<P, M>,
+  config: Config.Interface,
+  mode: "process" | "control" = "process",
+  source?: object,
+): Tool.Def<P, M> {
+  if (!enabled()) return def
+  const original = def.execute
+  return {
+    ...def,
+    execute: (args, ctx) =>
+      Effect.gen(function* () {
+        const instance = yield* InstanceState.context
+        const bridge = yield* EffectBridge.make()
+        const kind = mode === "control" || (source && controls.has(source)) ? "control" : "process"
+        const scope = {
+          directory: instance.directory,
+          sessionID: ctx.sessionID,
+          messageID: ctx.messageID,
+          callID: ctx.callID,
+          tool: def.id,
+        }
+        return yield* Effect.uninterruptibleMask((restore) =>
+          Effect.gen(function* () {
+            const argsDigest = createHash("sha256")
+              .update(JSON.stringify([def.id, args, kind]))
+              .digest("hex")
+            const started = Schema.decodeUnknownSync(Launch)(
+              yield* Effect.promise(async () => {
+                try {
+                  return await rpc({ ...scope, action: "begin", argsDigest, kind })
+                } catch (cause) {
+                  // The begin response may have been lost after durable reservation.
+                  // This branch has never spawned a process, including on interruption.
+                  try {
+                    await rpc({ ...scope, action: "cancel-before-start" })
+                  } catch {
+                    const message = cause instanceof Error ? cause.message : "local_execution_failed"
+                    throw new Error(`${message}; execution did not start; cleanup unconfirmed`, { cause })
+                  }
+                  throw cause
+                }
+              }),
+            )
+            const receipt = { ...scope, token: started.lease.token }
+            if (kind === "control")
+              return yield* restore(original(args, ctx)).pipe(
+                Effect.ensuring(Effect.promise(() => rpc({ ...receipt, action: "finish" }))),
+              )
+            const cfg = yield* config.get()
+            const controller = new AbortController()
+            const pending = execute({
+              started,
+              args,
+              tool: def.id,
+              ctx,
+              config: {
+                ...cfg,
+                plugin: [...(resolvedPlugins.get(instance.directory) ?? [])].map(([entry, options]) =>
+                  options === undefined ? entry : [entry, options],
+                ),
+              },
+              files: toolFiles.get(instance.directory) ?? [],
+              signal: AbortSignal.any([ctx.abort, controller.signal]),
+              receipt,
+              metadata: (value) => bridge.promise(ctx.metadata(value)),
+              ask: (value) => bridge.promise(ctx.ask(value)),
+            })
+            // A provider cancellation acknowledges the entire native process tree,
+            // including the publication finalizer, before releasing its session fence.
+            const result = yield* restore(Effect.promise(() => pending)).pipe(
+              Effect.onInterrupt(() =>
+                Effect.promise(async () => {
+                  controller.abort()
+                  await pending.catch(() => {})
+                }),
+              ),
+            )
+            // Native tools' metadata is intentionally open; the wire decoder above
+            // validates the shared result contract before rejoining their typed caller.
+            return result as Tool.ExecuteResult<M>
+          }),
+        )
+      }),
+  }
+}
+
+async function execute(input: {
+  started: typeof Launch.Type
+  args: unknown
+  tool: string
+  ctx: Tool.Context
+  config: unknown
+  files: string[]
+  signal: AbortSignal
+  receipt: object
+  metadata: Tool.Context["metadata"] extends (x: infer A) => unknown ? (value: A) => Promise<void> : never
+  ask: Tool.Context["ask"] extends (x: infer A) => unknown ? (value: A) => Promise<void> : never
+}) {
+  const launch = input.started.launch
+  if (!launch) throw new Error("mutation_runtime_unsupported")
+  const environment: NodeJS.ProcessEnv = {
+    ...process.env,
+    ...launch.environment,
+    HOME: launch.scratchDirectory,
+    XDG_CONFIG_HOME: path.join(launch.scratchDirectory, "config"),
+    XDG_DATA_HOME: path.join(launch.scratchDirectory, "data"),
+    XDG_STATE_HOME: path.join(launch.scratchDirectory, "state"),
+    XDG_CACHE_HOME: path.join(launch.scratchDirectory, "cache"),
+    OPENCODE_TEST_HOME: launch.scratchDirectory,
+    OPENCODE_TEST_MANAGED_CONFIG_DIR: path.join(launch.scratchDirectory, "managed"),
+    DEVRYAN_EXECUTION_WORKER: "1",
+    OPENCODE_DISABLE_DEFAULT_PLUGINS: "true",
+    OPENCODE_DISABLE_PROJECT_CONFIG: "true",
+    OPENCODE_DISABLE_AUTOUPDATE: "true",
+    OPENCODE_DISABLE_MODELS_FETCH: "true",
+    OPENCODE_EXPERIMENTAL_DISABLE_FILEWATCHER: "true",
+  }
+  // Never pass a host control credential to a tool or its descendants.
+  for (const key of Object.keys(environment))
+    if (
+      /^(DEVRYAN_.*(?:TOKEN|URL)|OPENCODE_SERVER_(?:PASSWORD|USERNAME)|OPENCODE_CONFIG(?:_DIR|_CONTENT)?|DEVRYAN_EXECUTION_CONTROL_PLUGINS)$/.test(
+        key,
+      )
+    )
+      delete environment[key]
+  const processArgs =
+    Bun.main.includes("$bunfs") || Bun.main.includes("~BUN") || process.execPath === Bun.main ? [] : [Bun.main]
+  const proc = spawn(
+    launch.launcher,
+    [...launch.arguments, process.execPath, ...processArgs, "debug", "devryan-tool"],
+    { cwd: launch.cwd, env: environment, stdio: ["pipe", "pipe", "pipe"], windowsHide: true },
+  )
+  let spawned = false
+  proc.once("spawn", () => {
+    spawned = true
+  })
+  const closed = new Promise<number | null>((resolve, reject) => {
+    proc.once("error", reject)
+    proc.once("close", resolve)
+  })
+  void closed.catch(() => {})
+  const cancel = () => {
+    if (process.platform !== "win32") {
+      proc.kill("SIGTERM")
+      return
+    }
+    const signal = () =>
+      execFile(launch.launcher, ["--cancel", launch.environment.DEVRYAN_EXECUTION_CANCEL_EVENT!], (cause) => {
+        if (cause && proc.exitCode === null && proc.signalCode === null) setTimeout(signal, 20).unref()
+      })
+    signal()
+  }
+  input.signal.addEventListener("abort", cancel, { once: true })
+  if (input.signal.aborted) cancel()
+  const remap = (value: unknown) =>
+    JSON.parse(
+      JSON.stringify(value).replaceAll(
+        JSON.stringify(input.started.lease.projectDirectory).slice(1, -1),
+        JSON.stringify(input.started.lease.viewDirectory).slice(1, -1),
+      ),
+    )
+  // File arguments have logical absolute names. Shell/code strings retain their
+  // spelling: native policy must reject attempts to write the original tree.
+  const args =
+    input.args && typeof input.args === "object"
+      ? Object.fromEntries(
+          Object.entries(input.args).map(([key, value]) => [
+            key,
+            ["filePath", "path", "workdir", "cwd"].includes(key) ? remap(value) : value,
+          ]),
+        )
+      : input.args
+  proc.stdin.on("error", () => {})
+  let result: typeof Result.Type | undefined,
+    error: Error | undefined,
+    bytes = 0
+  proc.stderr.on("data", (data) => {
+    if (process.env.DEVRYAN_EXECUTION_TRACE === "1") process.stderr.write(data)
+  })
+  try {
+    proc.stdin.write(
+      JSON.stringify({
+        tool: input.tool,
+        args,
+        sessionID: input.ctx.sessionID,
+        messageID: input.ctx.messageID,
+        callID: input.ctx.callID,
+        agent: input.ctx.agent,
+        messages: input.ctx.messages,
+        extra: input.ctx.extra,
+        config: input.config,
+        files: input.files,
+        projectDirectory: input.started.lease.viewDirectory,
+        logicalDirectory: input.receipt && "directory" in input.receipt ? input.receipt.directory : undefined,
+      }) + "\n",
+    )
+    for await (const line of createInterface({ input: proc.stdout, crlfDelay: Infinity })) {
+      bytes += Buffer.byteLength(line)
+      if (bytes > 32 * 1024 * 1024) throw new Error("Confined tool output exceeded its protocol limit")
+      if (!line.startsWith(prefix)) continue
+      const frame = Schema.decodeUnknownSync(Frame)(JSON.parse(line.slice(prefix.length)))
+      if (frame.type === "result") {
+        result = frame.result
+        continue
+      }
+      if (frame.type === "error") {
+        error = new Error(frame.message)
+        continue
+      }
+      if (frame.type === "metadata") {
+        await input.metadata(frame.value)
+        continue
+      }
+      const approved = await input
+        .ask({ ...frame.value, patterns: [...frame.value.patterns], always: [...frame.value.always] })
+        .then(
+          () => true,
+          () => false,
+        )
+      proc.stdin.write(JSON.stringify({ id: frame.id, approved }) + "\n")
+    }
+    await closed
+  } catch (cause) {
+    cancel()
+    await closed.catch(() => {})
+    error = cause instanceof Error ? cause : new Error("Confined tool failed")
+  } finally {
+    input.signal.removeEventListener("abort", cancel)
+    if (!spawned) await rpc({ ...input.receipt, action: "cancel-before-start" })
+    else await rpc({ ...input.receipt, action: "finish" })
+  }
+  if (error) throw error
+  if (!result) throw new Error("Confined tool exited without a result")
+  return Schema.decodeUnknownSync(Result)(
+    JSON.parse(
+      JSON.stringify(result).replaceAll(
+        JSON.stringify(input.started.lease.viewDirectory).slice(1, -1),
+        JSON.stringify(input.started.lease.projectDirectory).slice(1, -1),
+      ),
+    ),
+  )
+}
