new file mode 100644
index 0000000..923c0f3
--- /dev/null
+++ b/packages/opencode/src/cli/cmd/debug/devryan-tool.handler.ts
@@ -0,0 +1,116 @@
+import { createInterface } from "node:readline"
+import { randomUUID } from "node:crypto"
+import { Effect, Schema, type Types } from "effect"
+import { SessionV1 } from "@opencode-ai/core/v1/session"
+import { SessionID, MessageID } from "@/session/schema"
+import { DevRyanExecution } from "@/session/devryan-execution"
+
+const Input = Schema.Struct({
+  tool: Schema.String,
+  args: Schema.Unknown,
+  config: Schema.Unknown,
+  files: Schema.Array(Schema.String),
+  messages: Schema.Array(SessionV1.WithParts),
+  extra: Schema.optional(Schema.Record(Schema.String, Schema.Unknown)),
+  sessionID: SessionID,
+  messageID: MessageID,
+  callID: Schema.String,
+  agent: Schema.String,
+  projectDirectory: Schema.String,
+  logicalDirectory: Schema.String,
+})
+const Reply = Schema.Struct({ id: Schema.String, approved: Schema.Boolean })
+
+export async function run() {
+  const started = Date.now()
+  const trace = (phase: string) => {
+    if (process.env.DEVRYAN_EXECUTION_TRACE === "1") process.stderr.write(`worker ${phase} ${Date.now() - started}ms\n`)
+  }
+  trace("input")
+  if (process.env.DEVRYAN_EXECUTION_WORKER !== "1") throw new Error("This command requires a confined execution lease")
+  const lines = createInterface({ input: process.stdin, crlfDelay: Infinity })
+  const iterator = lines[Symbol.asyncIterator]()
+  const first = await iterator.next()
+  if (first.done || Buffer.byteLength(first.value) > 16 * 1024 * 1024) throw new Error("Invalid tool execution input")
+  const input = Schema.decodeUnknownSync(Input)(JSON.parse(first.value))
+  process.env.OPENCODE_CONFIG_CONTENT = JSON.stringify({
+    ...Schema.decodeUnknownSync(Schema.Record(Schema.String, Schema.Unknown))(input.config),
+    snapshot: false,
+    watcher: { ignore: ["**/*"] },
+  })
+  process.env.DEVRYAN_LOGICAL_DIRECTORY = input.logicalDirectory
+  process.env.DEVRYAN_EXECUTION_TOOL_FILES = JSON.stringify(input.files)
+  const pending = new Map<string, { resolve: () => void; reject: (cause: Error) => void }>()
+  const replyLoop = (async () => {
+    while (true) {
+      const line = await iterator.next()
+      if (line.done) break
+      const reply = Schema.decodeUnknownSync(Reply)(JSON.parse(line.value))
+      const waiter = pending.get(reply.id)
+      pending.delete(reply.id)
+      if (reply.approved) waiter?.resolve()
+      else waiter?.reject(new Error("Permission denied"))
+    }
+    for (const waiter of pending.values()) waiter.reject(new Error("Host disconnected"))
+  })()
+  void replyLoop.catch(() => {
+    for (const waiter of pending.values()) waiter.reject(new Error("Invalid host response"))
+  })
+  const send = (frame: typeof DevRyanExecution.Frame.Type) => {
+    process.stdout.write(DevRyanExecution.prefix + JSON.stringify(frame) + "\n")
+  }
+  const { AppRuntime } = await import("@/effect/app-runtime")
+  const { InstanceStore } = await import("@/project/instance-store")
+  const { ToolRegistry } = await import("@/tool/registry")
+  trace("runtime")
+  try {
+    const result = await AppRuntime.runPromise(
+      Effect.gen(function* () {
+        const store = yield* InstanceStore.Service
+        return yield* store.provide(
+          { directory: process.cwd() },
+          Effect.gen(function* () {
+            const registry = yield* ToolRegistry.Service
+            trace("registry")
+            const tool = (yield* registry.all()).findLast((def) => def.id === input.tool)
+            trace("execute")
+            if (!tool) throw new Error(`Confined tool is unavailable: ${input.tool}`)
+            return yield* tool.execute(input.args, {
+              sessionID: input.sessionID,
+              messageID: input.messageID,
+              callID: input.callID,
+              agent: input.agent,
+              messages: structuredClone(input.messages) as Types.DeepMutable<typeof input.messages>,
+              extra: input.extra,
+              abort: new AbortController().signal,
+              metadata: (value) => Effect.sync(() => send({ type: "metadata", value })),
+              ask: (value) =>
+                Effect.promise(
+                  () =>
+                    new Promise<void>((resolve, reject) => {
+                      const id = randomUUID()
+                      pending.set(id, { resolve, reject })
+                      send({ type: "permission", id, value })
+                    }),
+                ),
+            })
+          }),
+        )
+      }),
+    )
+    send({ type: "result", result })
+    trace("result")
+  } catch (cause) {
+    send({ type: "error", message: cause instanceof Error ? cause.message : "Confined tool failed" })
+    process.exitCode = 1
+  } finally {
+    lines.close()
+    process.stdin.destroy()
+    await AppRuntime.runPromise(InstanceStore.Service.use((store) => store.disposeAll()))
+    trace("disposed")
+    // Plugin timers and worker pools belong to this one execution. Flush the
+    // protocol, then let the native supervisor reap every remaining child.
+    await new Promise<void>((resolve) => process.stdout.write("", () => resolve()))
+    process.exit(process.exitCode ?? 0)
+  }
+}
