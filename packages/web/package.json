{
  "name": "@openchamber/web",
  "version": "1.2.2",
  "private": false,
  "type": "module",
  "main": "./server/index.js",
  "types": "./server/index.d.ts",
  "bin": {
    "openchamber": "./bin/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun run build:watch",
    "dev:server": "bun server/index.js --port ${OPENCHAMBER_PORT:-3001}",
    "dev:server:watch": "node ./scripts/dev-server-watch.mjs",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint \"./src/**/*.{ts,tsx}\" --config ../../eslint.config.js --cache --cache-location ../../.cache/eslint/web",
    "test": "vitest run --no-file-parallelism --maxWorkers=1",
    "start": "node bin/cli.js serve"
  },
  "dependencies": {
    "@ag-ui/core": "0.0.58",
    "@clack/prompts": "^1.7.0",
    "@openchamber/bots-runtime": "workspace:*",
    "@openchamber/cursor-sdk-runtime": "workspace:*",
    "@openchamber/harness-runtime": "workspace:*",
    "@openchamber/orchestration-runtime": "workspace:*",
    "@openchamber/shared-runtime": "workspace:*",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@octokit/rest": "^22.0.1",
    "@opencode-ai/sdk": "^1.18.30",
    "@simplewebauthn/server": "13.3.0",
    "adm-zip": "^0.6.0",
    "better-sqlite3": "^12.11.1",
    "bun-pty": "^0.4.10",
    "compression": "^1.8.1",
    "cron-parser": "^4.9.0",
    "express": "^5.2.1",
    "http-proxy-middleware": "^3.0.7",
    "jose": "^6.2.12",
    "jsonc-parser": "^3.3.1",
    "luxon": "^3.7.2",
    "node-pty": "1.2.0-beta.12",
    "openai": "^4.104.0",
    "qrcode-terminal": "^0.12.0",
    "reflect-metadata": "^0.2.2",
    "simple-git": "^3.36.0",
    "web-push": "^3.6.7",
    "ws": "^8.21.3",
    "yaml": "^2.9.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.30",
    "@base-ui/react": "^1.8.0",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-go": "^6.0.1",
    "@eslint/js": "^9.39.5",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@remixicon/react": "^4.9.0",
    "@simplewebauthn/browser": "13.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/supertest": "^7.2.1",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "ghostty-web": "0.3.0",
    "globals": "^16.5.0",
    "nodemon": "^3.1.14",
    "mammoth": "1.12.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^15.6.6",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "strip-json-comments": "^5.0.3",
    "tailwind-merge": "^3.6.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.69.0",
    "unpdf": "1.8.0",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "workbox-window": "^7.4.1",
    "zustand": "^5.0.15",
    "@openchamber/ui": "workspace:*"
  },
  "files": [
    "dist",
    "server/**",
    "!server/default-config/agents/*.test.*",
    "!server/default-config/agents/*.spec.*",
    "!server/default-config/plugins/*.test.*",
    "!server/default-config/plugins/*.spec.*",
    "!server/default-config/user-profile/**/test-*.md",
    "bin",
    "public",
    "package.json",
    "README.md"
  ]
}
