// The lint configuration for first-party JavaScript (.js, .mjs, .cjs, .jsx).
// It extends the TypeScript configuration, so both run the same rule set; only
// the changes below differ, each with its reason. `bun run lint` runs it through
// scripts/check-js-lint.mjs, which compares the findings with the shrink-only
// baseline scripts/js-lint-baseline.json (docs/TESTING.md, "JavaScript lint").
// Override and ignore paths are relative to the repository root, where this file lives.
{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./.oxlintrc.json"],
  // The JavaScript here runs in Node (the web backend, Electron's main process,
  // the runtime packages, scripts) as well as in browsers.
  "env": {
    "browser": true,
    "node": true,
    "es2022": true
  },
  // Not first-party code; never linted. `extends` does not carry the TypeScript
  // configuration's ignorePatterns, which ignore every JavaScript file.
  "ignorePatterns": [
    // Vendored upstream code (jsdom, imagegen, ast-grep, the model catalog), pinned by hash in its manifest.json; editing it breaks the reviewed-input contract.
    "packages/web/runtime/reviewed-inputs/**",
    // Generated by scripts/generate-opencode-v2-routes.mjs; regenerate it, never edit it.
    "packages/web/server/lib/opencode/v2/routes.generated.js"
  ],
  "rules": {
    // Every hit on this JavaScript is deliberate: path and identifier validators and terminal-escape strippers match control characters on purpose (2.1 scout: 62 of 62).
    "no-control-regex": "off",
    // Every hit is an empty best-effort catch (kill, close, unlink, fsync); empty blocks other than catch clauses stay errors (2.1 scout: 172 of 172).
    "no-empty": ["error", { "allowEmptyCatch": true }],
    // Every hit is `cond ? a() : b()` or `x && y()` used as a statement; other unused expressions stay errors (2.1 scout: 10 of 10).
    "no-unused-expressions": ["error", { "allowTernary": true, "allowShortCircuit": true }],
    // Every hit is a deliberately never-yielding async generator that holds a stream open or fails on first pull (2.1 scout: 9 of 9).
    "require-yield": "off"
  },
  "overrides": [
    {
      // CommonJS preloads and Electron .cjs files must load modules with require().
      "files": ["**/*.cjs"],
      "rules": { "typescript/no-require-imports": "off" }
    },
    {
      // Fixture entry files of the root visual and performance tests, not modules that Fast Refresh reloads.
      "files": ["tests/**"],
      "rules": { "react/only-export-components": "off" }
    },
    {
      // Conformance and fuzz vector generators: imprecise numbers, sparse arrays and runs of spaces are the vectors.
      "files": [
        "packages/native/crates/config-text/tests/**",
        "packages/harness-runtime/native/ledger-core/tests/**",
        "scripts/client-conformance/**"
      ],
      "rules": {
        "no-loss-of-precision": "off",
        "no-sparse-arrays": "off",
        "no-regex-spaces": "off"
      }
    }
  ]
}
