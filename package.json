{
  "name": "openchamber-monorepo",
  "version": "1.2.3",
  "description": "OpenChamber monorepo workspace for web, ui, and desktop runtimes",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "keywords": [
    "opencode",
    "ai",
    "coding",
    "openchamber",
    "cli"
  ],
  "author": "Bohdan Triapitsyn",
  "license": "MIT",
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "agent:eval": "node ./scripts/agent-evals/main.mjs",
    "perf:electron": "node ./scripts/perf/electron-resource-benchmark.mjs",
    "perf:pipeline": "node ./scripts/perf/session-pipeline-profile.mjs",
    "build": "bun run build:web && bun run build:electron",
    "build:web": "bun run --cwd packages/web build",
    "build:ui": "bun run type-check:ui",
    "build:desktop": "bun run --cwd packages/desktop build",
    "build:electron": "bun run --cwd packages/electron build",
    "type-check": "bun run --filter '*' type-check",
    "type-check:affected": "node scripts/validate.mjs type-check-affected",
    "type-check:web": "bun run --cwd packages/web type-check",
    "type-check:ui": "bun run --cwd packages/ui type-check",
    "type-check:desktop": "bun run --cwd packages/desktop type-check",
    "type-check:electron": "bun run --cwd packages/electron type-check",
    "lint": "bun run --filter '*' lint",
    "lint:changed": "node scripts/validate.mjs lint-changed",
    "test": "bun run test:full",
    "test:affected": "node scripts/validate.mjs test-affected",
    "test:scripts": "node scripts/test-scripts.mjs",
    "test:visual-fixture": "bun test tests/visual-production-bots/matrix.test.mjs",
    "test:full": "bun run test:scripts && bun run test:visual-fixture && bun run --cwd packages/bots-runtime test && bun run --cwd packages/bot-supervisor test && bun run --cwd packages/bot-engine-proxy test && bun run --cwd packages/bot-egress test && bun run --cwd packages/bot-computer test && bun run --cwd packages/bot-indexer test && bun run --cwd packages/shared-runtime test && bun run --cwd packages/harness-runtime test && bun run --cwd packages/orchestration-runtime test && bun run --cwd packages/cursor-sdk-runtime test && bun run --cwd packages/electron test && bun run --cwd packages/desktop test && bun run --cwd packages/ui test && bun run --cwd packages/web test",
    "validate:quick": "node scripts/validate.mjs quick",
    "validate:affected": "node scripts/validate.mjs affected",
    "validate:full": "node scripts/validate.mjs full",
    "lint:web": "bun run --cwd packages/web lint",
    "lint:ui": "bun run --cwd packages/ui lint",
    "lint:desktop": "bun run --cwd packages/desktop lint",
    "lint:electron": "bun run --cwd packages/electron lint",
    "clean": "bun run --filter '*' clean",
    "bundle:check": "node scripts/check-bundle-budgets.mjs",
    "postinstall": "patch-package",
    "dev:web": "bun run --cwd packages/web build:watch",
    "dev:web:server": "bun run --cwd packages/web dev:server:watch",
    "dev:web:full": "node ./scripts/dev-web-full.mjs",
    "dev:web:hmr": "node ./scripts/dev-web-hmr.mjs",
    "start:web": "bun run --cwd packages/web start",
    "pack:web": "bun run build:web && node scripts/pack-web-release.mjs",
    "desktop:start-cli": "node ./packages/desktop/scripts/opencode-cli.mjs start",
    "desktop:stop-cli": "node ./packages/desktop/scripts/opencode-cli.mjs stop",
    "desktop:dev": "node ./packages/desktop/scripts/desktop-dev.mjs",
    "desktop:build": "bun run --cwd packages/desktop build:sidecar && bun run --cwd packages/desktop tauri build",
    "electron:dev": "node ./packages/electron/scripts/electron-dev.mjs",
    "electron:test:native-pointer": "bun run --cwd packages/electron smoke:native-bot-create",
    "electron:test:native-pointer:packaged": "bun run --cwd packages/electron smoke:native-bot-create:packaged",
    "visual:bots:dev": "bun run --cwd tests/visual-production-bots dev",
    "visual:bots:build": "bun run --cwd tests/visual-production-bots type-check && bun run --cwd tests/visual-production-bots build",
    "visual:bots:package-shell": "node ./scripts/package-production-bots-visual-shell.mjs",
    "visual:bots:capture": "bun run visual:bots:build && node ./scripts/capture-production-bots-visuals.mjs",
    "visual:bots:capture:packaged": "bun run visual:bots:build && bun run visual:bots:package-shell && node ./scripts/capture-production-bots-visuals.mjs --electron-mode packaged",
    "visual:bots:acceptance": "bun run visual:bots:capture:packaged && bun run electron:test:native-pointer:packaged",
    "smoke:bots:memory-recovery": "node ./scripts/smoke-bot-memory-recovery.mjs",
    "electron:build": "bun run --cwd packages/electron package",
    "desktop:lint": "bun run --cwd packages/desktop lint && cargo fmt --manifest-path packages/desktop/src-tauri/Cargo.toml -- --check && cargo clippy --manifest-path packages/desktop/src-tauri/Cargo.toml -- -D warnings",
    "desktop:type-check": "bun run --cwd packages/desktop type-check && cargo fmt --manifest-path packages/desktop/src-tauri/Cargo.toml -- --check && cargo clippy --manifest-path packages/desktop/src-tauri/Cargo.toml -- -D warnings",
    "docs:validate": "node scripts/docs/validate-docs.mjs",
    "icons:sprite": "node scripts/generate-file-type-sprite.mjs",
    "themes:port:opencode": "tsx scripts/port-opencode-theme.ts",
    "version:bump": "node scripts/bump-version.mjs",
    "release:prepare": "bun run build && bun run type-check && bun run lint",
    "release:test": "./scripts/test-release-build.sh",
    "release:test:intel": "./scripts/test-release-build.sh x86_64",
    "release:test:arm": "./scripts/test-release-build.sh aarch64",
    "qa": "node scripts/qa/run.mjs",
    "perf:reducer": "bun scripts/perf/streaming-reducer-benchmark.mjs"
  },
  "dependencies": {
    "@opencode-ai/sdk": "^1.18.30",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "overrides": {
    "@codemirror/language": "6.12.2",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.39.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/dom-speech-recognition": "^0.0.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^9.2.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "nodemon": "^3.1.14",
    "patch-package": "^8.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.3.6",
    "yaml": "^2.9.0",
    "electron": "41.2.1",
    "ghostty-web": "0.3.0"
  }
}
