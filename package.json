{
  "name": "devryan-monorepo",
  "version": "2.0.5",
  "description": "DevRyan monorepo workspace for web, ui, and desktop runtimes",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "keywords": [
    "opencode",
    "ai",
    "coding",
    "devryan",
    "cli"
  ],
  "author": "Bohdan Triapitsyn",
  "license": "MIT",
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "agent:eval": "node ./scripts/agent-evals/main.mjs",
    "perf:electron": "node ./scripts/perf/electron-resource-benchmark.mjs",
    "perf:harness": "node ./scripts/perf/harness-resource-benchmark.mjs",
    "perf:compare": "node ./scripts/perf/harness-comparison.mjs",
    "perf:pipeline": "node ./scripts/perf/session-pipeline-profile.mjs",
    "build": "bun run --cwd packages/electron build:web-assets && bun run build:electron",
    "build:web": "bun run --cwd packages/web build",
    "build:ui": "bun run type-check:ui",
    "build:desktop": "bun run --cwd packages/desktop build",
    "build:electron": "bun run --cwd packages/electron build",
    "type-check": "bun run --sequential --filter '*' type-check",
    "type-check:diagnose": "node scripts/typecheck-diagnostics.mjs",
    "type-check:web": "bun run --cwd packages/web type-check",
    "type-check:ui": "bun run --cwd packages/ui type-check",
    "type-check:desktop": "bun run --cwd packages/desktop type-check",
    "type-check:electron": "bun run --cwd packages/electron type-check",
    "lint": "bun run --filter '*' lint",
    "test": "bun run test:full",
    "test:scripts": "node scripts/test-scripts.mjs",
    "test:startup": "node scripts/test-startup-contract.mjs",
    "test:timings:update": "node scripts/update-test-timings.mjs",
    "test:full": "node scripts/test-full.mjs",
    "validate": "node scripts/validate.mjs fast",
    "validate:full": "node scripts/validate.mjs full",
    "lint:web": "bun run --cwd packages/web lint",
    "lint:ui": "bun run --cwd packages/ui lint",
    "lint:desktop": "bun run --cwd packages/desktop lint",
    "lint:electron": "bun run --cwd packages/electron lint",
    "cache:report": "node scripts/storage.mjs report",
    "cache:prune": "node scripts/storage.mjs clean",
    "clean": "bun run cache:prune",
    "bundle:check": "node scripts/check-bundle-budgets.mjs",
    "app:check": "node scripts/check-packaged-app.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "release:status": "node scripts/release-status.mjs",
    "release:tag": "node scripts/release-tag.mjs",
    "dev:web": "bun run --cwd packages/web build:watch",
    "dev:web:server": "bun run --cwd packages/web dev:server:watch",
    "dev:web:full": "node ./scripts/dev-web-full.mjs",
    "dev:web:hmr": "node ./scripts/dev-web-hmr.mjs",
    "start:web": "bun run --cwd packages/web start",
    "pack:web": "bun run build:web && node scripts/pack-web-release.mjs",
    "desktop:start-cli": "node ./packages/desktop/scripts/opencode-cli.mjs start",
    "desktop:stop-cli": "node ./packages/desktop/scripts/opencode-cli.mjs stop",
    "desktop:dev": "node ./packages/desktop/scripts/desktop-dev.mjs",
    "desktop:build": "bun run --cwd packages/desktop build:sidecar && bun run --cwd packages/desktop tauri build",
    "electron:dev": "node ./packages/electron/scripts/electron-dev.mjs",
    "electron:build": "bun run --cwd packages/electron package",
    "desktop:lint": "bun run --cwd packages/desktop lint && cargo fmt --manifest-path packages/desktop/src-tauri/Cargo.toml -- --check && cargo clippy --manifest-path packages/desktop/src-tauri/Cargo.toml -- -D warnings",
    "desktop:type-check": "bun run --cwd packages/desktop type-check && cargo fmt --manifest-path packages/desktop/src-tauri/Cargo.toml -- --check && cargo clippy --manifest-path packages/desktop/src-tauri/Cargo.toml -- -D warnings",
    "docs:validate": "node scripts/docs/validate-docs.mjs",
    "icons:sprite": "node scripts/generate-file-type-sprite.mjs",
    "themes:port:opencode": "bun scripts/port-opencode-theme.ts",
    "version:bump": "node scripts/bump-version.mjs",
    "qa": "node scripts/qa/run.mjs",
    "perf:reducer": "bun scripts/perf/streaming-reducer-benchmark.mjs",
    "perf:reducer:compare": "bun scripts/perf/reducer-comparison.mjs",
    "perf:resource-gate": "node ./scripts/perf/resource-gate.mjs",
    "build:revert-runtime": "node scripts/build-revert-runtime.mjs",
    "verify:revert-runtime": "node scripts/verify-revert-runtime-artifacts.mjs"
  },
  "dependencies": {
    "@opencode-ai/sdk": "^1.18.33",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "4.6.5"
  },
  "overrides": {
    "@codemirror/language": "6.12.2",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.39.13"
  },
  "patchedDependencies": {
    "@modelcontextprotocol/client@2.3.1": "patches/@modelcontextprotocol%2Fclient@2.3.1.patch"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@opencode/ai": "2.2.1",
    "@opencode/core": "2.2.1",
    "@opencode/plugin": "2.2.1",
    "@opencode/schema": "2.2.1",
    "@opencode/simulation": "2.2.1",
    "@opencode/util": "2.2.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/dom-speech-recognition": "^0.0.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^10.0.6",
    "effect": "4.0.1",
    "electron": "44.9.3",
    "nodemon": "^3.1.14",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "yaml": "^2.9.0"
  }
}
